<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/translucentDark"
    tools:context=".TemperatureActivity">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:fontFamily="@font/montserrat"
        android:text="Температура"
        android:textAlignment="center"
        android:textSize="53sp"
        android:textStyle="bold"
        android:textColor="@color/textDark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageView
        android:id="@+id/heater_image"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/heater_image"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginLeft="50dp"/>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:visibility="gone"
        android:indeterminate="true"
        android:indeterminateTint="@color/accentSun"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/center_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">>
        <LinearLayout
            android:id="@+id/temperature_Value_Block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/temp_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:textColor="@color/textDark"
                android:textSize="25sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:text=" ℃"
                android:textColor="@color/textDark"
                android:textSize="25sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/mode_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Автоматический режим"
            android:textColor="@color/textDark"
            android:textSize="25sp"
            android:fontFamily="@font/montserrat"
            app:layout_constraintTop_toBottomOf="@id/heater_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:id="@+id/manual_controls"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/mode_switch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:visibility="visible">

            <Button
                android:id="@+id/btn_heater_on"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Включить"
                android:textColor="@color/accentSun"
                android:backgroundTint="@color/translucentDark"
                app:strokeColor="@color/accentSun"
                app:cornerRadius="24dp"
                android:layout_marginLeft="8dp"
                />

            <Button
                android:id="@+id/btn_heater_off"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Выключить"
                android:textColor="@color/accentSun"
                android:backgroundTint="@color/translucentDark"
                app:strokeColor="@color/accentSun"
                app:cornerRadius="24dp"
                android:layout_marginRight="8dp"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/auto_controls"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/mode_switch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp"
            android:visibility="gone"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/target_input"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:inputType="number"
                android:textColor="@color/textDark"
                android:backgroundTint="@color/translucentDark"
                app:strokeColor="@color/accentSun"
                app:cornerRadius="24dp"/>

            <Button
                android:id="@+id/btn_set_target"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Установить"
                android:textColor="@color/accentSun"
                android:backgroundTint="@color/translucentDark"
                app:strokeColor="@color/accentSun"
                app:cornerRadius="24dp"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/back_btn"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="@color/translucentDark"
        android:text="Назад"
        android:textColor="@color/accentSun"
        android:textSize="18sp"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconTint="@color/accentSun"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeColor="@color/accentSun" />
</androidx.constraintlayout.widget.ConstraintLayout>
