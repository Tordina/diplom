<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/translucentDark"
    tools:context=".MainActivity">
    <TextView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:fontFamily="@font/montserrat"
        android:text="@string/logo"
        android:textAlignment="center"
        android:textSize="73sp"
        android:textStyle="bold"
        android:textColor="@color/textDark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/choiceBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/translucentDark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo"
        tools:ignore="MissingConstraints">
        <Button
            android:id="@+id/but_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/translucentDark"
            android:text="@string/but_btn"
            android:textColor="@color/accentSun"
            android:textSize="20sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_battery"
            app:iconTint="@color/accentSun"
            app:strokeColor="@color/accentSun"
            />

        <Button
            android:id="@+id/lamps_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/translucentDark"
            android:text="@string/lamps_btn"
            android:textColor="@color/accentSun"
            android:textSize="20sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_lamps"
            app:iconTint="@color/accentSun"
            app:strokeColor="@color/accentSun"
            />

        <Button
            android:id="@+id/temp_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/translucentDark"
            android:text="@string/temp_btn"
            android:textColor="@color/accentSun"
            android:textSize="20sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_temperature"
            app:iconTint="@color/accentSun"
            app:strokeColor="@color/accentSun"
            />

        <Button
            android:id="@+id/water_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/translucentDark"
            android:text="@string/water_btn"
            android:textColor="@color/accentSun"
            android:textSize="20sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_water"
            app:iconTint="@color/accentSun"
            app:strokeColor="@color/accentSun"
            />

        <Button
            android:id="@+id/ventilation_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/translucentDark"
            android:text="@string/ventilation_btn"
            android:textColor="@color/accentSun"
            android:textSize="20sp"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_ventilation"
            app:iconTint="@color/accentSun"
            app:strokeColor="@color/accentSun"
            />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
