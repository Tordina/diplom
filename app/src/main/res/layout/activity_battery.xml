<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/translucentDark"
    tools:context=".BatteryActivity">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:fontFamily="@font/montserrat"
        android:text="Батарея"
        android:textAlignment="center"
        android:textSize="73sp"
        android:textStyle="bold"
        android:textColor="@color/textDark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Блок с зарядом посередине экрана -->
    <LinearLayout
        android:id="@+id/сharge_Unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/charge_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:text="Заряд:  "
            android:textColor="@color/textDark"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/result_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textColor="@color/textDark"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/percent_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:text="%"
            android:textAlignment="center"
            android:textColor="@color/textDark"
            android:textSize="25sp" />
    </LinearLayout>

    <Button
        android:id="@+id/back_btn"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="@color/translucentDark"
        android:text="Назад"
        android:textColor="@color/accentSun"
        android:textSize="18sp"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconPadding="12dp"
        app:iconTint="@color/accentSun"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeColor="@color/accentSun" />

</androidx.constraintlayout.widget.ConstraintLayout>